# Normalise line endings in the repository; check out with the platform default.
* text=auto eol=lf

# Source and configuration files are always LF, matching .editorconfig.
*.py     text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.sh     text eol=lf

# Windows scripts keep CRLF so they run correctly.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary assets must never be converted.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.whl    binary
